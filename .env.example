# Copy to `.env` and adjust. Restart `npm run dev` after changes.

# Browser → API
# VITE_AUTH_API_URL=https://tai-auth.transformativeai.co

# Leave UNSET during local dev so `/api/v1/*` goes through Vite proxy (same origin → no CORS).
# Setting VITE_SIGNALS_API_URL makes the browser call TAI directly; some routes may lack
# Access-Control-Allow-Origin and fail (e.g. dashboard/risk-exposure) while others succeed.
# If Swagger works but the UI gets 502 via Vite proxy, fix proxy/upstream — only then consider direct URL + CORS.
# VITE_SIGNALS_API_URL=https://tai-signals.transformativeai.co


# Vite dev proxy (auth always; /api/v1 only used when VITE_SIGNALS_API_URL is unset)
VITE_AUTH_PROXY_TARGET=https://tai-auth.transformativeai.co
VITE_SIGNAL_PROXY_TARGET=https://tai-signals.transformativeai.co

# If you must proxy /api/v1: TLS issues on Node→upstream
# VITE_SIGNAL_PROXY_INSECURE=true

# Signal Engine `X-API-Key`: usually the hex key from GET /api/auth/signal-key (app fetches after login).
# Paste here only if that call fails: VITE_SIGNALS_API_KEY=...
# Rare: Signal accepts login JWT as X-API-Key → VITE_SIGNAL_USE_ACCESS_TOKEN=true
